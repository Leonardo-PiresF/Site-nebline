# Copie para .env e preencha.
# Sem as duas primeiras variaveis a loja roda em modo demonstracao,
# guardando pedidos so no navegador.

# Supabase: Project Settings, API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Senha do painel APENAS no modo demonstracao, quando nao ha Supabase.
# Com Supabase configurado, o login e por email e senha e esta variavel
# e ignorada.
VITE_ADMIN_SENHA=nebline

# So preencha quando a WhatsApp Business Cloud API estiver contratada.
# Deve apontar para uma serverless function sua, nunca para a Meta direto.
VITE_WHATSAPP_API_URL=
